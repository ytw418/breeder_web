// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  relationMode = "prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  relationMode = "prisma"
}

enum role {
  USER
  FAKE_USER
  ADMIN
  SUPER_USER
}

enum UserStatus {
  ACTIVE        // 사용중
  BANNED        // 영구정지
  DELETED       // 삭제
  SUSPENDED_7D  // 7일정지
  SUSPENDED_30D // 한달정지
}

enum MessageType {
  TEXT
  IMAGE
}

enum GuinnessRecordType {
  size
  weight
}

enum GuinnessSubmissionStatus {
  pending
  approved
  rejected
}

enum GuinnessRejectionReasonCode {
  photo_blur
  measurement_not_visible
  contact_missing
  invalid_value
  insufficient_description
  suspected_manipulation
  other
}

enum BreederProgramType {
  FOUNDING_BREEDER
  PARTNER_BREEDER
  VERIFIED_BREEDER
}

enum BreederProgramStatus {
  ACTIVE
  REVOKED
}

enum BreederProgramSource {
  AUTO_SIGNUP
  MANUAL_ADMIN
  SELF_VERIFICATION
}

enum BreederProgramFeeBenefitType {
  NONE
  LIFETIME_AUCTION_FEE_FREE
  AUCTION_FEE_PERCENT_DISCOUNT
}

model User {
  id              Int         @id @default(autoincrement())
  role            role        @default(USER)
  status          UserStatus @default(ACTIVE)
  snsId           String      @unique
  provider        String      
  phone           String?     @unique
  email           String?     @unique
  name            String      @unique
  avatar          String?
  /// 프로필 소개(최대 150자, libs/shared/profile.ts normalizeBio). 비우면 null. (docs/prd: 앱 profile.md)
  bio             String?
  /// 고정(Pin)한 관심 카테고리 id 목록. 비어 있으면 전체 보기. (docs/prd: 카테고리 고정)
  pinnedCategoryIds Int[]     @default([])
  /// 탈퇴 시각. status=DELETED 와 함께 설정한다.
  deletedAt       DateTime?
  /// 정지·차단·탈퇴 시 +1. access/refresh 의 tv 클레임과 비교
  tokenVersion    Int         @default(0)
  /// SUSPENDED_* 만료 시각. 로그인 시 지났으면 ACTIVE 로 복귀
  suspendedUntil  DateTime?
  /// 내 동네(시/도 · 시/군/구). libs/shared/regions.ts 목록의 조합만 저장한다. 좌표는 저장하지 않는다.
  regionSido      String?
  regionSigungu   String?
  /// 동네 브리더 목록에 나를 보여줄지(opt-in, 기본 false). 동네를 지우면 같이 false.
  regionVisible   Boolean     @default(false)
  regionUpdatedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  products        Product[]
  posts           Post[]
  Likes           Like[]
  Comments        Comment[]
  writtenReviews  Review[]    @relation(name: "writtenReviews")
  receivedReviews Review[]    @relation(name: "receivedReviews")
  fav             Fav[]
  sales           Sale[]
  purchases       Purchase[]
  record          Record[]
  messages        Message[]
  followers       Follow[]    @relation(name: "follower")
  following       Follow[]    @relation(name: "following")
  chatRoomMember    ChatRoomMember[]
  notifications     Notification[]  @relation(name: "notifications")
  sentNotifications Notification[]  @relation(name: "sentNotifications")
  fcmTokens         FcmToken[]
  auctions        Auction[]
  bids            Bid[]
  badges          UserBadge[]
  breederPrograms BreederProgramMembership[]
  missionProgress UserMissionProgress[]
  alertSubscriptions AlertSubscription[]
  bloodlineFollows BloodlineFollow[]
  auctionReportsSubmitted AuctionReport[] @relation("AuctionReportReporter")
  auctionReportsReceived  AuctionReport[] @relation("AuctionReportReportedUser")
  auctionReportsResolved  AuctionReport[] @relation("AuctionReportResolver")
  reportsSubmitted        Report[]        @relation("ReportReporter")
  reportsReceived         Report[]        @relation("ReportReportedUser")
  reportsResolved         Report[]        @relation("ReportResolver")
  blocksInitiated         UserBlock[]     @relation("UserBlockBlocker")
  blocksReceived          UserBlock[]     @relation("UserBlockBlocked")
  createdBloodlineCards     BloodlineCard[]        @relation("BloodlineCardCreator")
  ownedBloodlineCards       BloodlineCard[]        @relation("BloodlineCardOwner")
  bloodlineCardEventsAsActor   BloodlineCardEvent[] @relation("BloodlineCardEventActor")
  bloodlineCardEventsFrom      BloodlineCardEvent[] @relation("BloodlineCardEventFrom")
  bloodlineCardEventsTo        BloodlineCardEvent[] @relation("BloodlineCardEventTo")
  bloodlineCardTransfersFrom BloodlineCardTransfer[] @relation("BloodlineCardTransferFrom")
  bloodlineCardTransfersTo   BloodlineCardTransfer[] @relation("BloodlineCardTransferTo")
  bloodlineCardOwnerRows     BloodlineCardOwner[]    @relation("BloodlineCardOwnerRows")
  insectRecords   InsectRecord[]
  guinnessSubmissions GuinnessSubmission[]
  moderationLogs  ModerationLog[] @relation("ModerationLogActor")
  profileAlbums   ProfileAlbum[]

  @@index([status, deletedAt])
  @@index([regionSido, regionSigungu, regionVisible])
}
model ChatRoom {
  id              Int               @id @default(autoincrement())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  chatRoomMembers ChatRoomMember[]
}


model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  chatRoomId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
  lastReadAt DateTime?

  @@unique([userId, chatRoomId])
  @@index([chatRoomId])
  @@index([userId])
}


model Message {
  id         Int         @id @default(autoincrement())
  type       MessageType @default(TEXT)
  message    String
  image      String?     // Cloudflare Images ID (IMAGE 타입일 때 사용)
  chatRoom   ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  chatRoomId Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([chatRoomId])
  @@index([userId])
}




/// 프로필 앨범(사용자가 만든 하이라이트). 사진 글 id 를 고른 순서대로 담는다(앱 docs/prd/profile.md F-9).
/// 지워졌거나 사진이 없어진 글 id 는 읽을 때 걸러 낸다. 한 사람당 10개, 앨범당 30장(libs/shared/profile.ts).
model ProfileAlbum {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  postIds   Int[]    @default([])

  @@index([userId, createdAt])
}

model Follow {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  follower    User     @relation(name: "follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  Int
  following   User     @relation(name: "following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId Int

  @@index([followerId])
  @@index([followingId])

}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Int?
  description String
  photos      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  favs        Fav[]
  sales       Sale[]
  purchases   Purchase[]
  records     Record[]
  // 2025.04.26일 추가 필드(아직 미사용)
  category String? // 예를 들면 곤충/강아지/고양이/파충류/물고기/기타/전체 등등 
  tags     String[]  // 태그는 문자열 배열로 저장
  isSold    Boolean @default(false)
  isDeleted Boolean @default(false)
  isHidden  Boolean @default(false)
  location       String?    // 거래 지역
  viewCount      Int        @default(0) // 조회수
  wishCount      Int        @default(0) // 찜/관심 수
  status         String     @default("판매중") // 판매 상태: 판매중, 예약중, 판매완료 등
  condition      String?    // 상품 컨디션: 새상품, 중고 등
  contactCount   Int        @default(0) // 문의/채팅 수
  expireAt       DateTime?  // 게시글 만료일
  deliveryType   String?    // 직거래/택배 등
  priceOfferable Boolean    @default(true) // 가격 제안 가능 여부
  mainImage      String?    // 대표 이미지
  isFeatured     Boolean    @default(false) // 추천 상품 여부
  reportCount    Int        @default(0) // 신고 횟수
  productType    String?    // 생물, 용품
  /// Category.id (가장 구체적인 분류 1개). category 문자열과 함께 저장한다(카테고리 고정 범위 조회용).
  categoryId     Int?
  /// 거래 유형: sale(판매) / adoption(분양) / rehoming(파양)
  dealType       String     @default("sale")
  /// 연결한 혈통(BloodlineCard, cardType=BLOODLINE). FK 없음(relationMode=prisma). 회수되면 상세 요약만 사라진다.
  bloodlineRootId Int?
  /// { sireMm?: number; damMm?: number; generation?: "F1".."F9" | "unknown" } — libs/shared/pedigree-note.ts
  pedigreeNote    Json?

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([categoryId])
  @@index([bloodlineRootId])
}

model Post {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title    String
  description String
  type String?
  category  String?     // 게시글 카테고리 (자유, 질문, 정보, 자랑, 후기)
  comments Comment[]
  latitude  Float?
  longitude Float?
  Likes      Like[]
  image       String      // 대표 이미지(= images[0]). 웹 단일 이미지 호환용으로 유지
  images      String[]    @default([]) // 게시글 사진(Cloudflare 이미지 id, 최대 10장)
  /// 운영자 숨김. 작성자·관리자에게만 보인다.
  isHidden    Boolean     @default(false)
  /// 작성자가 프로필 사진 그리드 맨 앞에 고정한 시각(사진 있는 글만, 한 사람당 최대 3개). 풀면 null.
  profilePinnedAt DateTime?
  /// 카테고리 '동네' 글에만 채운다. 등록 시점 작성자 동네를 복사한 값(작성자가 동네를 바꿔도 안 바뀜).
  regionSido    String?
  regionSigungu String?
  /// Category.id (종 분류, type 문자열과 함께 저장). 카테고리 고정 범위 조회용.
  categoryId    Int?

  @@index([userId])
  @@index([category])
  @@index([category, regionSido, regionSigungu])
  @@index([isHidden, createdAt])
  @@index([categoryId])
}

/// 관심 카테고리 트리(깊이 제한 없음). path 는 '/reptile/tortoise/' 처럼 조상 slug 를 이은 값이라
/// 하위 전체 조회는 path prefix 비교로 한다. isVisible=false 면 선택지·결과에서 빠진다.
model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String
  parentId  Int?
  path      String   @unique
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  comment String
  /// 운영자 숨김. 작성자·관리자에게만 보인다.
  isHidden Boolean @default(false)

  @@index([userId])
  @@index([postId])

}


model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  @@index([userId])
  @@index([postId])

}

model Review {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  review       String   
  createdBy    User     @relation(name: "writtenReviews", fields: [createdById], references: [id], onDelete: Cascade)
  createdById  Int
  createdFor   User     @relation(name: "receivedReviews", fields: [createdForId], references: [id], onDelete: Cascade)
  createdForId Int
  score        Int      @default(1)

  @@index([createdById])
  @@index([createdForId])

}

model Sale {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending") // pending, completed
  @@index([userId])
  @@index([productId])
}

model Purchase {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending") // pending, completed
  @@index([userId])
  @@index([productId])
}

model Fav {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([productId])
}

model Record {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  kind      String
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([productId])
}

enum Kind {
  Purchase
  Sale
  Fav
}

enum NotificationType {
  LIKE          // 좋아요
  COMMENT       // 댓글
  CHAT          // 채팅 메시지
  FOLLOW        // 팔로우
  FAV           // 상품 찜
  NEW_PRODUCT   // 팔로우한 유저가 새 상품 등록
  NEW_POST      // 팔로우한 유저가 새 게시글 등록
  BID           // 내 경매에 새 입찰
  OUTBID        // 내가 입찰한 경매에서 더 높은 입찰 발생
  AUCTION_WON   // 경매 낙찰
  AUCTION_END   // 내 경매 종료
  NEW_RECORD    // 기네스북 기록 갱신
  BREEDER_RANK_DROP
  BREEDER_OVERTAKEN
  BLOODLINE_OVERTAKEN
  AUCTION_RECORD_BROKEN
  BLOODLINE_RECEIVED   // 출처 카드를 받았거나 혈통을 넘겨받음
}

enum SeasonKind {
  WEEKLY
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum BadgeType {
  TOP_BREEDER
  TOP_BLOODLINE
  HIGHEST_AUCTION_SELLER
}

enum RankingEntityType {
  USER
  BLOODLINE
  AUCTION
}

enum AlertType {
  BREEDER_RANK_DROP
  BREEDER_OVERTAKEN
  BLOODLINE_OVERTAKEN
  AUCTION_RECORD_BROKEN
}

model Notification {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  message    String           // 알림 메시지 (예: "홍길동님이 좋아요를 눌렀습니다")
  isRead     Boolean          @default(false)
  user       User             @relation(name: "notifications", fields: [userId], references: [id], onDelete: Cascade)
  userId     Int              // 알림을 받는 유저
  sender     User             @relation(name: "sentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   Int              // 알림을 발생시킨 유저
  targetId   Int?             // 대상 ID (게시글, 상품, 채팅방, 경매 등)
  targetType String?          // 대상 타입 ("post", "product", "chatRoom", "auction")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([senderId])
  @@index([userId, isRead])
}

model Season {
  id        Int          @id @default(autoincrement())
  kind      SeasonKind
  startAt   DateTime
  endAt     DateTime
  status    SeasonStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  badges          UserBadge[]
  missionProgress UserMissionProgress[]

  @@unique([kind, startAt, endAt])
  @@index([kind, status, startAt, endAt])
}

model BreederProgramMembership {
  id                 Int                    @id @default(autoincrement())
  userId             Int
  programType        BreederProgramType
  status             BreederProgramStatus   @default(ACTIVE)
  source             BreederProgramSource
  badgeLabel         String
  frameVariant       String
  foundingNo         Int?
  feeBenefitType     BreederProgramFeeBenefitType @default(NONE)
  feeDiscountPercent Int?
  grantedAt          DateTime               @default(now())
  revokedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programType])
  @@unique([programType, foundingNo])
  @@index([userId, status])
  @@index([programType, status, grantedAt])
}

model UserBadge {
  id         Int               @id @default(autoincrement())
  userId     Int
  seasonId   Int
  badgeType  BadgeType
  rank       Int
  entityType RankingEntityType
  entityId   Int?
  label      String
  createdAt  DateTime          @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, badgeType, rank])
  @@index([userId, createdAt])
  @@index([seasonId, badgeType, rank])
}

model MissionTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  targetCount Int
  rewardLabel String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserMissionProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  seasonId    Int
  missionKey  String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, missionKey])
  @@index([seasonId, missionKey])
  @@index([userId, completedAt])
}

model AlertSubscription {
  id         Int               @id @default(autoincrement())
  userId     Int
  alertType  AlertType
  entityType RankingEntityType
  entityId   Int
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  state AlertState?

  @@unique([userId, alertType, entityType, entityId])
  @@index([enabled, alertType])
}

model AlertState {
  id                Int      @id @default(autoincrement())
  subscriptionId    Int      @unique
  lastObservedRank  Int?
  lastObservedValue Float?
  lastNotifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscription AlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model BloodlineFollow {
  id              Int      @id @default(autoincrement())
  userId          Int
  bloodlineRootId Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bloodlineRootId])
  @@index([bloodlineRootId, createdAt])
}

model FcmToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

// ============================================================
// 경매 시스템
// ============================================================

model Auction {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  photos          String[]
  category        String?   // 종 카테고리 (장수풍뎅이, 사슴벌레 등)
  sellerPhone     String?
  sellerEmail     String?
  sellerBlogUrl   String?
  sellerCafeNick  String?
  sellerBandNick  String?
  sellerProofImage String?
  sellerTrustNote String?
  bloodlineRootId Int?
  startPrice      Int       // 시작가
  currentPrice    Int       // 현재 최고 입찰가
  minBidIncrement Int       @default(1000) // 최소 입찰 단위 (원)
  endAt           DateTime  // 경매 종료 시간
  status          String    @default("진행중") // 진행중, 종료, 유찰, 취소

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  bids            Bid[]
  reports         AuctionReport[]
  winnerId        Int?      // 낙찰자 ID
  /// 운영자 숨김. 작성자·관리자에게만 보인다. 숨길 때 진행중이면 취소한다.
  isHidden        Boolean   @default(false)
  /// { sireMm?, damMm?, generation? } — libs/shared/pedigree-note.ts. bloodlineRootId 가 없으면 null.
  pedigreeNote    Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endAt])
  @@index([category])
  @@index([bloodlineRootId, endAt])
}

model Bid {
  id         Int      @id @default(autoincrement())
  amount     Int      // 입찰 금액
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId  Int
  createdAt  DateTime @default(now())

  @@index([auctionId])
  @@index([userId])
}

enum AuctionReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum AuctionReportAction {
  NONE
  STOP_AUCTION
  BAN_USER
  STOP_AUCTION_AND_BAN
}

model AuctionReport {
  id               Int                 @id @default(autoincrement())
  auctionId        Int
  reporterId       Int
  reportedUserId   Int
  reason           String
  detail           String
  status           AuctionReportStatus @default(OPEN)
  resolutionAction AuctionReportAction @default(NONE)
  resolutionNote   String?
  resolvedBy       Int?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  auction      Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reporter     User    @relation("AuctionReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User    @relation("AuctionReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolver     User?   @relation("AuctionReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([auctionId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// 운영자 조치 기록(숨김·숨김 해제·삭제)
// ============================================================

enum ModerationTargetType {
  POST
  COMMENT
  PRODUCT
  AUCTION
  BLOODLINE_CARD
}

enum ModerationActionType {
  HIDE
  UNHIDE
  DELETE
}

model ModerationLog {
  id           Int                  @id @default(autoincrement())
  actorId      Int
  targetType   ModerationTargetType
  targetId     Int
  /// 콘텐츠 작성자. 삭제 뒤에도 추적한다.
  targetUserId Int?
  action       ModerationActionType
  reason       String?
  /// 신고 처리에서 온 조치면 Report.id
  reportId     Int?
  /// 삭제 시 원문 보존용 { title, excerpt }
  snapshot     Json?
  createdAt    DateTime             @default(now())

  actor User @relation("ModerationLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

// ============================================================
// 통합 신고 · 사용자 차단
// ============================================================

enum ReportTargetType {
  POST
  COMMENT
  PRODUCT
  CHAT_ROOM
  USER
  BLOODLINE_CARD
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ReportAction {
  NONE
  REMOVE_CONTENT
  BAN_USER
  REMOVE_CONTENT_AND_BAN
}

/// 게시글·댓글·상품·채팅방·사용자 통합 신고. 경매 신고는 AuctionReport 를 그대로 쓴다.
model Report {
  id               Int              @id @default(autoincrement())
  targetType       ReportTargetType
  /// 대상 id. CHAT_ROOM 이면 채팅방 id, USER 면 사용자 id.
  targetId         Int
  reporterId       Int
  reportedUserId   Int
  reason           String
  detail           String?
  status           ReportStatus     @default(OPEN)
  resolutionAction ReportAction     @default(NONE)
  resolutionNote   String?
  resolvedBy       Int?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reporter     User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolver     User? @relation("ReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status, createdAt])
}

/// blocker 가 blocked 를 차단. 콘텐츠 숨김은 단방향, 채팅은 양방향 금지.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ============================================================
// 기네스북 (곤충 기록 시스템)
// ============================================================

model InsectRecord {
  id          Int      @id @default(autoincrement())
  species     String   // 종명 (장수풍뎅이, 사슴벌레 등)
  recordType  String   // "size" (크기 mm) 또는 "weight" (무게 g)
  value       Float    // 실제 측정값
  photo       String   // 증거 사진 (Cloudflare Image ID)
  description String?  // 추가 설명

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  isVerified  Boolean  @default(false) // 관리자 검증 여부

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([species, recordType])
  @@index([userId])
  @@index([species, recordType, value])
}

model GuinnessSpecies {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  aliases    String[]
  isActive   Boolean  @default(true)
  isOfficial Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  submissions GuinnessSubmission[]
}

model GuinnessSubmission {
  id               Int      @id @default(autoincrement())
  userId           Int
  userName         String
  species          String
  speciesId        Int?
  speciesRawText   String?
  recordType       GuinnessRecordType
  value            Float
  measurementDate  DateTime?
  description      String?
  proofPhotos      String[]
  contactPhone     String?
  contactEmail     String?
  consentToContact Boolean
  submittedAt      DateTime @default(now())
  slaDueAt         DateTime
  resubmitCount    Int      @default(0)
  status           GuinnessSubmissionStatus @default(pending)
  reviewReasonCode GuinnessRejectionReasonCode?
  reviewMemo       String?
  reviewedBy       Int?
  reviewedAt       DateTime?
  approvedRecordId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesRef  GuinnessSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([species, recordType])
  @@index([status])
}

model AdminBanner {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  href        String
  bgClass     String
  order       Int
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model BloodlineCard {
  id                   Int                      @id @default(autoincrement())
  cardType             BloodlineCardType        @default(BLOODLINE)
  speciesType          String?
  bloodlineReferenceId Int?
  parentCardId         Int?
  status               BloodlineCardStatus      @default(ACTIVE)
  transferPolicy       BloodlineCardTransferPolicy @default(NONE)
  issueCount           Int                      @default(0)
  transferCount        Int                      @default(0)
  visualStyle          String                   @default("noir")
  creatorId            Int
  currentOwnerId       Int
  name                 String
  description          String?
  image                String?
  /// 산지. libs/shared/regions.ts REGIONS 의 sido / sigungu 값. sigungu 는 sido 가 있을 때만.
  originSido           String?
  originSigungu        String?
  /// 출처 카드(LINE) 보유자가 켜면 혈통 페이지·프로필에 닉네임이 보인다. 카드가 다음 사람에게 옮겨가면 false 로 돌아간다.
  ownerNameVisible     Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  creator                  User                  @relation("BloodlineCardCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  currentOwner             User                  @relation("BloodlineCardOwner", fields: [currentOwnerId], references: [id], onDelete: Cascade)
  events                   BloodlineCardEvent[]
  transfers                BloodlineCardTransfer[]
  owners                   BloodlineCardOwner[]

  @@index([cardType, currentOwnerId, createdAt])
  @@index([cardType, creatorId, createdAt])
  @@index([bloodlineReferenceId])
  @@index([parentCardId])
  @@index([currentOwnerId, createdAt])
  @@index([creatorId])
}

model BloodlineCardEvent {
  id           Int      @id @default(autoincrement())
  cardId       Int
  action       BloodlineCardEventType
  actorUserId  Int?
  fromUserId   Int?
  toUserId     Int?
  note         String?
  createdAt    DateTime @default(now())

  card         BloodlineCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser    User?         @relation("BloodlineCardEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromUser     User?         @relation("BloodlineCardEventFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser       User?         @relation("BloodlineCardEventTo", fields: [toUserId], references: [id], onDelete: SetNull)
  relatedCardId Int?

  @@index([cardId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

model BloodlineCardTransfer {
  id         Int      @id @default(autoincrement())
  cardId     Int
  fromUserId Int?
  toUserId   Int
  note       String?
  createdAt  DateTime @default(now())

  card     BloodlineCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromUser User?         @relation("BloodlineCardTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User          @relation("BloodlineCardTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([toUserId, createdAt])
}

/// 보유자 테이블. 예전 런타임 DDL 로 만들던 것을 편입한다(20261009000100_bloodline_v2_schema).
/// currentOwnerId 의 거울일 뿐 권한 판정에는 쓰지 않는다(libs/server/bloodline-ownership.ts). P2 에서 삭제 후보.
model BloodlineCardOwner {
  bloodlineCardId Int
  userId          Int
  grantedAt       DateTime @default(now())

  card BloodlineCard @relation(fields: [bloodlineCardId], references: [id], onDelete: Cascade)
  user User          @relation("BloodlineCardOwnerRows", fields: [userId], references: [id], onDelete: Cascade)

  @@id([bloodlineCardId, userId])
  @@index([userId, bloodlineCardId])
}

enum BloodlineCardType {
  BLOODLINE
  LINE
}

enum BloodlineCardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum BloodlineCardTransferPolicy {
  NONE
  ONE_TIME
  LIMITED_CHAIN
  LIMITED_COUNT
  VERIFIED_ONLY
}

enum BloodlineCardEventType {
  BLOODLINE_CREATED
  BLOODLINE_TRANSFER
  LINE_CREATED
  LINE_ISSUED
  LINE_TRANSFER
  CARD_REVOKED
}

enum VoiceInquiryType {
  BUG_REPORT
  FEATURE_REQUEST
  DEV_TEAM_REQUEST
}

enum VoiceInquiryStatus {
  OPEN
  IN_REVIEW
  DONE
  REJECTED
}

model VoiceInquiry {
  id           Int                @id @default(autoincrement())
  type         VoiceInquiryType
  status       VoiceInquiryStatus @default(OPEN)
  title        String
  description  String
  contactEmail String
  requesterId  Int?
  requesterName String?
  adminNote    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model LandingPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

/// 탈퇴자 개인정보 분리 보관. 30일 뒤 원문은 파기하고 행(userId, snsIdHash)만 남긴다.
model UserDeletionRecord {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  provider    String
  /// 보관 기간 중 원문. 파기 시 null
  snsId       String?
  /// HMAC-SHA256(snsId). 파기 후에도 탈퇴 이력 확인용으로 유지
  snsIdHash   String
  email       String?
  phone       String?
  /// 탈퇴 전 닉네임 (CS 식별용)
  name        String?
  reason      String?
  requestedAt DateTime  @default(now())
  purgeAt     DateTime
  purgedAt    DateTime?

  @@index([snsId])
  @@index([snsIdHash])
  @@index([purgeAt, purgedAt])
}
