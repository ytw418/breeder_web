// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  relationMode = "prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  relationMode = "prisma"
}

enum role {
  USER
  FAKE_USER
  ADMIN
  SUPER_USER
}

enum UserStatus {
  ACTIVE        // 사용중
  BANNED        // 영구정지
  DELETED       // 삭제
  SUSPENDED_7D  // 7일정지
  SUSPENDED_30D // 한달정지
  SUSPENDED     // 기간 정지(suspendedUntil 까지). 새 정지는 모두 이 값을 쓴다(SUSPENDED_7D·30D 는 옛 행 호환용)
}

enum MessageType {
  TEXT
  IMAGE
}

enum GuinnessRecordType {
  size
  weight
}

enum GuinnessSubmissionStatus {
  pending
  approved
  rejected
}

enum GuinnessRejectionReasonCode {
  photo_blur
  measurement_not_visible
  contact_missing
  invalid_value
  insufficient_description
  suspected_manipulation
  other
}

enum BreederProgramType {
  FOUNDING_BREEDER
  PARTNER_BREEDER
  VERIFIED_BREEDER
}

enum BreederProgramStatus {
  ACTIVE
  REVOKED
}

enum BreederProgramSource {
  AUTO_SIGNUP
  MANUAL_ADMIN
  SELF_VERIFICATION
}

enum BreederProgramFeeBenefitType {
  NONE
  LIFETIME_AUCTION_FEE_FREE
  AUCTION_FEE_PERCENT_DISCOUNT
}

model User {
  id              Int         @id @default(autoincrement())
  role            role        @default(USER)
  status          UserStatus @default(ACTIVE)
  snsId           String      @unique
  provider        String      
  phone           String?     @unique
  email           String?     @unique
  name            String      @unique
  /// 마지막으로 본인이 닉네임을 바꾼 시각. 30일 안이면 다시 못 바꾼다(libs/shared/nickname.ts). null = 가입 때 받은 이름 그대로(첫 변경은 바로 된다).
  nameChangedAt   DateTime?
  avatar          String?
  /// 프로필 소개(최대 300자, libs/shared/profile.ts normalizeBio). 비우면 null. (docs/prd: 앱 profile.md)
  bio             String?
  /// 프로필 커버(배너) 이미지 Cloudflare id. 3:1 로 잘라 보여 준다. 비우면 null. (앱 profile.md v5)
  profileBanner   String?
  /// 프로필 대표 링크(http/https, 최대 300자, libs/shared/profile.ts normalizeProfileLink). 비우면 null.
  profileLink     String?
  /// 대표 칭호 key(libs/shared/breederKeywords.ts BreederTitleKey — talk·post 등). 단 칭호 중 랭킹 대상끼리 비교해 가장 두드러진 것.
  /// 랭킹 크론(ranking-alerts)이 하루 한 번 libs/server/breederTitles.ts refreshTitleKeys 로 갱신한다. 없으면 null(앱 docs/prd/community-vibe.md §3.3).
  titleKey        String?
  /// 고정(Pin)한 관심 카테고리 id 목록. 비어 있으면 전체 보기. (docs/prd: 카테고리 고정)
  pinnedCategoryIds Int[]     @default([])
  /// 관심 카테고리 온보딩을 마친(건너뛴 것 포함) 시각. 앱·웹 어디서든 한 번 마치면 다시 묻지 않는다(앱 docs/parity 대응표 O-1).
  categoryOnboardedAt DateTime?
  /// 탈퇴 시각. status=DELETED 와 함께 설정한다.
  deletedAt       DateTime?
  /// 정지·차단·탈퇴 시 +1. access/refresh 의 tv 클레임과 비교
  tokenVersion    Int         @default(0)
  /// SUSPENDED·SUSPENDED_* 만료 시각. 로그인 시 지났으면 ACTIVE 로 복귀
  suspendedUntil  DateTime?
  /// 내 동네(시/도 · 시/군/구). libs/shared/regions.ts 목록의 조합만 저장한다. 좌표는 저장하지 않는다.
  regionSido      String?
  regionSigungu   String?
  /// 동네 브리더 목록에 나를 보여줄지(opt-in, 기본 false). 동네를 지우면 같이 false.
  regionVisible   Boolean     @default(false)
  regionUpdatedAt DateTime?
  /// 알림 종류별 끄기·방해 금지(libs/shared/notificationPrefs.ts normalizePrefs). 비어 있으면 모두 켜짐·방해 금지 꺼짐. 앱 docs/prd/notifications.md
  notificationPrefs Json?
  /// 마지막 활동(로그인한 요청이 들어온) 시각. 인증(libs/server/auth.ts)에서 KST 하루 한 번만 갱신한다. 배포 전 활동은 비어 있다. 주간 요약 푸시·운영자 발송 대상(커뮤니티 감사 #22)
  lastActiveAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  products        Product[]
  posts           Post[]
  Likes           Like[]
  Comments        Comment[]
  commentLikes    CommentLike[]
  writtenReviews  Review[]    @relation(name: "writtenReviews")
  receivedReviews Review[]    @relation(name: "receivedReviews")
  fav             Fav[]
  sales           Sale[]
  purchases       Purchase[]
  record          Record[]
  messages        Message[]
  followers       Follow[]    @relation(name: "follower")
  following       Follow[]    @relation(name: "following")
  chatRoomMember    ChatRoomMember[]
  notifications     Notification[]  @relation(name: "notifications")
  sentNotifications Notification[]  @relation(name: "sentNotifications")
  fcmTokens         FcmToken[]
  auctions        Auction[]
  bids            Bid[]
  badges          UserBadge[]
  breederPrograms BreederProgramMembership[]
  missionProgress UserMissionProgress[]
  alertSubscriptions AlertSubscription[]
  bloodlineFollows BloodlineFollow[]
  regionVisits    RegionVisit[]
  wavesSent       ChatWave[]  @relation("WaveSent")
  wavesReceived   ChatWave[]  @relation("WaveReceived")
  debateVotes     DebateVote[]
  townMessages    TownMessage[]
  auctionReportsSubmitted AuctionReport[] @relation("AuctionReportReporter")
  auctionReportsReceived  AuctionReport[] @relation("AuctionReportReportedUser")
  auctionReportsResolved  AuctionReport[] @relation("AuctionReportResolver")
  reportsSubmitted        Report[]        @relation("ReportReporter")
  reportsReceived         Report[]        @relation("ReportReportedUser")
  reportsResolved         Report[]        @relation("ReportResolver")
  blocksInitiated         UserBlock[]     @relation("UserBlockBlocker")
  blocksReceived          UserBlock[]     @relation("UserBlockBlocked")
  createdBloodlineCards     BloodlineCard[]        @relation("BloodlineCardCreator")
  ownedBloodlineCards       BloodlineCard[]        @relation("BloodlineCardOwner")
  bloodlineCardEventsAsActor   BloodlineCardEvent[] @relation("BloodlineCardEventActor")
  bloodlineCardEventsFrom      BloodlineCardEvent[] @relation("BloodlineCardEventFrom")
  bloodlineCardEventsTo        BloodlineCardEvent[] @relation("BloodlineCardEventTo")
  bloodlineCardTransfersFrom BloodlineCardTransfer[] @relation("BloodlineCardTransferFrom")
  bloodlineCardTransfersTo   BloodlineCardTransfer[] @relation("BloodlineCardTransferTo")
  bloodlineCardOwnerRows     BloodlineCardOwner[]    @relation("BloodlineCardOwnerRows")
  insectRecords   InsectRecord[]
  guinnessSubmissions GuinnessSubmission[]
  moderationLogs  ModerationLog[] @relation("ModerationLogActor")
  sanctionsReceived UserSanction[] @relation("UserSanctionTarget")
  sanctionsIssued   UserSanction[] @relation("UserSanctionActor")
  profileAlbums   ProfileAlbum[]
  postSubscriptions PostSubscription[]

  @@index([status, deletedAt])
  @@index([regionSido, regionSigungu, regionVisible])
  @@index([lastActiveAt])
}
model ChatRoom {
  id              Int               @id @default(autoincrement())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  chatRoomMembers ChatRoomMember[]
}


model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  chatRoomId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
  lastReadAt DateTime?
  /// 채팅방 나가기 시각(앱 docs/prd/chat-room-settings.md). 이 시각 이전 메시지는 이 멤버에게만 보이지 않는다.
  leftAt     DateTime?
  /// 채팅방 알림을 끈 시각. 있으면 이 방 새 메시지 푸시를 이 멤버에게 보내지 않는다.
  mutedAt    DateTime?

  @@unique([userId, chatRoomId])
  @@index([chatRoomId])
  @@index([userId])
}


model Message {
  id         Int         @id @default(autoincrement())
  type       MessageType @default(TEXT)
  message    String
  image      String?     // Cloudflare Images ID (IMAGE 타입일 때 사용)
  chatRoom   ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  chatRoomId Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  /// 분양글 카드 행이면 분양글 id(FK·관계 없음, 읽을 때 일괄 조회). type 은 TEXT 그대로(MessageType 을 늘리지 않는다).
  /// message 에는 옛 앱·푸시·미리보기용 스냅샷 "[분양글] 제목 · 가격"(libs/shared/tradeChat.ts). 카드 행은 서버만 만든다. 앱 docs/prd/trade-review.md
  productId  Int?

  @@index([chatRoomId])
  @@index([userId])
  @@index([chatRoomId, productId])
}




/// 프로필 앨범(사용자가 만든 하이라이트). 사진 글 id 를 고른 순서대로 담는다(앱 docs/prd/profile.md F-9).
/// 지워졌거나 사진이 없어진 글 id 는 읽을 때 걸러 낸다. 한 사람당 10개, 앨범당 30장(libs/shared/profile.ts).
model ProfileAlbum {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  postIds   Int[]    @default([])

  @@index([userId, createdAt])
}

model Follow {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  follower    User     @relation(name: "follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  Int
  following   User     @relation(name: "following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId Int

  // 같은 사람을 두 번 팔로우한 행이 생기지 않게 한다(2026-10-21 커뮤니티 감사 #15 — 운영·dev 중복 0건 확인 뒤 추가).
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])

}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Int?
  description String
  photos      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  favs        Fav[]
  sales       Sale[]
  purchases   Purchase[]
  records     Record[]
  /// 이 분양글에 달린 거래 후기(Review.productId). 앱 docs/prd/trade-review.md
  tradeReviews Review[]
  // 2025.04.26일 추가 필드(아직 미사용)
  category String? // 예를 들면 곤충/강아지/고양이/파충류/물고기/기타/전체 등등 
  tags     String[]  // 태그는 문자열 배열로 저장
  isSold    Boolean @default(false)
  isDeleted Boolean @default(false)
  isHidden  Boolean @default(false)
  location       String?    // 거래 지역
  viewCount      Int        @default(0) // 조회수
  wishCount      Int        @default(0) // 찜/관심 수
  status         String     @default("판매중") // 판매 상태: 판매중, 예약중, 판매완료 등
  condition      String?    // 상품 컨디션: 새상품, 중고 등
  contactCount   Int        @default(0) // 문의/채팅 수
  expireAt       DateTime?  // 게시글 만료일
  deliveryType   String?    // 직거래/택배 등
  priceOfferable Boolean    @default(true) // 가격 제안 가능 여부
  mainImage      String?    // 대표 이미지
  isFeatured     Boolean    @default(false) // 추천 상품 여부
  reportCount    Int        @default(0) // 신고 횟수
  productType    String?    // 생물, 용품
  /// Category.id (가장 구체적인 분류 1개). category 문자열과 함께 저장한다(카테고리 고정 범위 조회용).
  categoryId     Int?
  /// 거래 유형: sale(판매) / adoption(분양) / rehoming(파양)
  dealType       String     @default("sale")
  /// 연결한 혈통(BloodlineCard, cardType=BLOODLINE). FK 없음(relationMode=prisma). 회수되면 상세 요약만 사라진다.
  bloodlineRootId Int?
  /// { sireMm?: number; damMm?: number; generation?: "F1".."F9" | "unknown" } — libs/shared/pedigree-note.ts
  pedigreeNote    Json?

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([categoryId])
  @@index([bloodlineRootId])
}

model Post {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title    String
  description String
  type String?
  category  String?     // 게시글 카테고리 (자유, 질문, 정보, 자랑, 후기)
  comments Comment[]
  latitude  Float?
  longitude Float?
  Likes      Like[]
  image       String      // 대표 이미지(= images[0]). 웹 단일 이미지 호환용으로 유지
  images      String[]    @default([]) // 게시글 사진(Cloudflare 이미지 id, 최대 10장)
  /// 운영자 숨김. 작성자·관리자에게만 보인다.
  isHidden    Boolean     @default(false)
  /// 작성자가 프로필 사진 그리드 맨 앞에 고정한 시각(사진 있는 글만, 한 사람당 최대 3개). 풀면 null.
  profilePinnedAt DateTime?
  /// 카테고리 '동네' 글에만 채운다. 등록 시점 작성자 동네를 복사한 값(작성자가 동네를 바꿔도 안 바뀜).
  regionSido    String?
  regionSigungu String?
  /// Category.id (종 분류, type 문자열과 함께 저장). 카테고리 고정 범위 조회용.
  categoryId    Int?
  /// 찬반 토론 글(category '토론')이면 선택지·기간. 앱 docs/prd/live-talk.md
  debate        Debate?
  /// 질문 글(category '질문')에서 질문자가 답변을 채택한 시각. 채택을 풀면 null(앱 docs/prd/feed-engagement.md '해결').
  resolvedAt        DateTime?
  /// 채택한 댓글 id. 관계 없이 id 만 둔다(댓글을 지워도 글은 그대로, 화면은 없는 id 를 무시한다).
  acceptedCommentId Int?
  /// 이 글 새 댓글 알림 구독(댓글을 달면 자동 구독, 상세 ⋯ '이 글 알림 끄기'로 muted).
  subscriptions PostSubscription[]

  @@index([userId])
  @@index([category])
  @@index([category, regionSido, regionSigungu])
  @@index([isHidden, createdAt])
  @@index([categoryId])
}

/// 관심 카테고리 트리(깊이 제한 없음). path 는 '/reptile/tortoise/' 처럼 조상 slug 를 이은 값이라
/// 하위 전체 조회는 path prefix 비교로 한다. isVisible=false 면 선택지·결과에서 빠진다.
model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String
  parentId  Int?
  path      String   @unique
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  comment String
  /// 운영자 숨김. 작성자·관리자에게만 보인다.
  isHidden Boolean @default(false)
  /// 대댓글이면 루트 댓글 id(1단계만). relationMode = "prisma" 의 자기 참조는 Cascade 를 흉내 내지 못해
  /// 관계 없이 id 만 둔다. 루트를 지울 때 답글은 코드에서 같이 지운다(libs/server/comments.ts).
  parentId Int?
  /// 작성자가 지운 시각. 답글이 남은 루트만 '삭제된 댓글입니다' 자리로 남기고 본문은 비운다.
  deletedAt DateTime?
  /// 작성자가 고친 시각. updatedAt 은 운영자 숨김에도 바뀌어 '수정됨' 표시에 쓰지 않는다.
  editedAt  DateTime?
  /// 토론 글 댓글이면 쓴 순간 작성자가 고른 쪽(작성자가 안 골랐거나 옛 앱이면 null). 나중에 바꿔도 그대로 둔다.
  stance    DebateSide?
  /// 답글의 답글이면 그 답글 작성자 id(본문 맨 앞 '@닉네임' 표시용). 루트에 바로 단 답글·루트 댓글은 null. 관계 없이 id 만 둔다.
  replyToUserId Int?
  likes     CommentLike[]

  @@index([userId])
  @@index([postId])
  @@index([parentId])

}


/// 댓글 좋아요. 사용자당 댓글 하나에 한 번(토글).
model CommentLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([userId, commentId])
  @@index([commentId])
}

/// 게시글 새 댓글 알림 구독. 댓글을 달면 자동으로 생기고(muted=false), 상세 ⋯ '이 글 알림 끄기'로 muted=true.
/// 새 댓글이 달리면 muted=false 인 구독자에게 알린다(같은 글은 1시간에 한 번, pages/api/posts/[id]/answers.ts).
model PostSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  muted     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId, muted])
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  @@index([userId])
  @@index([postId])

}

model Review {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  review       String   
  createdBy    User     @relation(name: "writtenReviews", fields: [createdById], references: [id], onDelete: Cascade)
  createdById  Int
  createdFor   User     @relation(name: "receivedReviews", fields: [createdForId], references: [id], onDelete: Cascade)
  createdForId Int
  /// 쓰지 않는 칸(거래 후기는 점수가 없다). 지우지 않고 1 로 둔다.
  score        Int      @default(1)
  /// 거래 후기가 달린 분양글(입양자 createdBy → 분양자 createdFor). 옛 행은 null. 1차는 글당 1개(코드 규칙),
  /// 스키마는 입양자별 1개(@@unique) — 한 글 여러 마리 분양으로 넓힐 때 마이그레이션이 필요 없게. 앱 docs/prd/trade-review.md
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    Int?
  /// libs/shared/tradeReview.ts TRADE_REVIEW_KEYWORDS 의 key 1~5개(정해진 순서). 자유 글은 없다(review 는 "").
  keywords     String[] @default([])
  /// 분양자 답글(한 번, 300자)
  reply        String?  @db.VarChar(300)
  repliedAt    DateTime?
  /// 운영자 숨김(PATCH /api/admin/reviews/:id). 숨긴 후기는 '후기 N'·집계에서 빠진다.
  isHidden     Boolean  @default(false)

  @@unique([productId, createdById])
  @@index([createdById])
  @@index([createdForId])
  @@index([createdForId, isHidden])

}

model Sale {
  id        Int      @id @default(autoincrement())
  /// 분양자(product.userId). 운영자가 남의 글을 분양완료해도 분양자로 남긴다.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending") // pending, completed, cancelled(분양완료 되돌리기)
  /// 분양자가 지정한 입양자(회원, FK·관계 없음). null = 미지정(옛 앱·'나중에 정할게요') 또는 브리디 밖. 앱 docs/prd/trade-review.md
  buyerId         Int?
  /// 'bredy'(회원 지정) | 'external'(브리디 밖에서 분양) | null(미지정)
  buyerSource     String?
  buyerAssignedAt DateTime?
  @@index([userId])
  @@index([productId])
  @@index([buyerId])
}

model Purchase {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending") // pending, completed(입양 확정), cancelled(분양완료 되돌리기)
  @@index([userId])
  @@index([productId])
}

model Fav {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([productId])
}

model Record {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  kind      String
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([productId])
}

enum Kind {
  Purchase
  Sale
  Fav
}

enum NotificationType {
  LIKE          // 좋아요
  COMMENT       // 댓글
  CHAT          // 채팅 메시지
  FOLLOW        // 팔로우
  FAV           // 상품 찜
  NEW_PRODUCT   // 팔로우한 유저가 새 상품 등록
  NEW_POST      // 팔로우한 유저가 새 게시글 등록
  BID           // 내 경매에 새 입찰
  OUTBID        // 내가 입찰한 경매에서 더 높은 입찰 발생
  AUCTION_WON   // 경매 낙찰
  AUCTION_END   // 내 경매 종료
  NEW_RECORD    // 기네스북 기록 갱신
  BREEDER_RANK_DROP
  BREEDER_OVERTAKEN
  BLOODLINE_OVERTAKEN
  AUCTION_RECORD_BROKEN
  BLOODLINE_RECEIVED   // 출처 카드를 받았거나 혈통을 넘겨받음
  MODERATION           // 운영 조치 안내(경고·정지·해제·숨김·삭제, 신고 처리 결과). 화면에는 보낸 사람 대신 '브리디 운영팀'
  RANK_UP              // 주간 브리더 순위 상승("순위가 올랐어요 · 7위 → 5위", /ranking?focus=me). 앱 docs/prd/community-vibe.md
  AUCTION_RESTARTED    // 분양자가 경매를 다시 시작(이전 낙찰자·지난 회차 입찰자에게). 앱 docs/prd/auction-restart.md
  DEBATE_RESULT        // 찬반 토론 결과(투표자·작성자에게, 끝난 뒤 한 번). 앱 docs/prd/live-talk.md
  DEBATE_MILESTONE     // 내 토론 참여 5·20·50명 도달(작성자에게)
  TOWN_REPLY           // 동네 사랑방에서 내 메시지에 답장·반겨 주기
  WEEKLY_DIGEST        // 며칠 안 온 회원에게 주 1회 '이번 주 인기글·내 글 반응' 요약(본인이 보낸 사람). 커뮤니티 감사 #22
  ADMIN_BROADCAST      // 운영자 푸시 발송(/admin/push·공지 '푸시도 보내기'). 화면에는 '브리디 운영팀', 하루 1회
  ANSWER_ACCEPTED      // 질문자가 내 답변을 채택(답한 사람에게). targetType post · commentId
  // 입양자 지정·거래 후기(앱 docs/prd/trade-review.md). 모두 설정 종류 trade, targetType product.
  ADOPTER_REQUESTED     // 회원이 미지정 분양글의 입양자 지정을 요청(분양자에게, 글·사람당 1번)
  ADOPTER_ASSIGNED      // 분양자가 입양자로 지정(입양자에게, 바꿨다 되돌려도 다시 보낸다)
  ADOPTION_CONFIRMED    // 입양자가 입양 확정(분양자에게)
  TRADE_REVIEW_RECEIVED // 입양자가 거래 후기를 남김(분양자에게)
  TRADE_REVIEW_REPLIED  // 분양자가 후기에 답글(입양자에게)
  // 재방문 알림(2026-10-23, 앱 docs/prd/reengagement-push.md, libs/server/reengagement.ts). 한 사람 하루 합계 2통, 종류마다 1통.
  NEARBY_FREE_PRODUCT // 같은 시/군/구 분양자가 무료 분양 등록(동네를 공개한 분양자만). targetType product
  DEBATE_CLOSING      // 관심 분야 HOT 토론이 1시간 안에 마감(아직 안 고른 회원에게). targetType post
  INTEREST_PRODUCTS   // 관심 분야 하루 새 분양 N건 묶음(저녁 한 통). targetType productList → 분양 탭
  QUESTION_HELP       // 답 없는 질문을 같은 분야 글을 써 본 회원에게. targetType post
}

enum SeasonKind {
  WEEKLY
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum BadgeType {
  TOP_BREEDER
  TOP_BLOODLINE
  HIGHEST_AUCTION_SELLER
}

enum RankingEntityType {
  USER
  BLOODLINE
  AUCTION
}

enum AlertType {
  BREEDER_RANK_DROP
  BREEDER_OVERTAKEN
  BLOODLINE_OVERTAKEN
  AUCTION_RECORD_BROKEN
}

model Notification {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  message    String           // 알림 메시지 (예: "홍길동님이 좋아요를 눌렀습니다")
  isRead     Boolean          @default(false)
  user       User             @relation(name: "notifications", fields: [userId], references: [id], onDelete: Cascade)
  userId     Int              // 알림을 받는 유저
  sender     User             @relation(name: "sentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   Int              // 알림을 발생시킨 유저
  targetId   Int?             // 대상 ID (게시글, 상품, 채팅방, 경매 등)
  targetType String?          // 대상 타입 ("post", "product", "chatRoom", "auction")
  commentId  Int?             // 게시글 댓글 알림이면 그 댓글 id(눌렀을 때 그 댓글로 스크롤)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([senderId])
  @@index([userId, isRead])
}

model Season {
  id        Int          @id @default(autoincrement())
  kind      SeasonKind
  startAt   DateTime
  endAt     DateTime
  status    SeasonStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  badges          UserBadge[]
  missionProgress UserMissionProgress[]

  @@unique([kind, startAt, endAt])
  @@index([kind, status, startAt, endAt])
}

model BreederProgramMembership {
  id                 Int                    @id @default(autoincrement())
  userId             Int
  programType        BreederProgramType
  status             BreederProgramStatus   @default(ACTIVE)
  source             BreederProgramSource
  badgeLabel         String
  frameVariant       String
  foundingNo         Int?
  feeBenefitType     BreederProgramFeeBenefitType @default(NONE)
  feeDiscountPercent Int?
  grantedAt          DateTime               @default(now())
  revokedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programType])
  @@unique([programType, foundingNo])
  @@index([userId, status])
  @@index([programType, status, grantedAt])
}

model UserBadge {
  id         Int               @id @default(autoincrement())
  userId     Int
  seasonId   Int
  badgeType  BadgeType
  rank       Int
  entityType RankingEntityType
  entityId   Int?
  label      String
  createdAt  DateTime          @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, badgeType, rank])
  @@index([userId, createdAt])
  @@index([seasonId, badgeType, rank])
}

model MissionTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  targetCount Int
  rewardLabel String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserMissionProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  seasonId    Int
  missionKey  String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, missionKey])
  @@index([seasonId, missionKey])
  @@index([userId, completedAt])
}

model AlertSubscription {
  id         Int               @id @default(autoincrement())
  userId     Int
  alertType  AlertType
  entityType RankingEntityType
  entityId   Int
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  state AlertState?

  @@unique([userId, alertType, entityType, entityId])
  @@index([enabled, alertType])
}

model AlertState {
  id                Int      @id @default(autoincrement())
  subscriptionId    Int      @unique
  lastObservedRank  Int?
  lastObservedValue Float?
  lastNotifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscription AlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model BloodlineFollow {
  id              Int      @id @default(autoincrement())
  userId          Int
  bloodlineRootId Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bloodlineRootId])
  @@index([bloodlineRootId, createdAt])
}

model FcmToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

// ============================================================
// 경매 시스템
// ============================================================

model Auction {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  photos          String[]
  category        String?   // 종 카테고리 (장수풍뎅이, 사슴벌레 등)
  /// Category.id(category 이름에서 푼 값). 관심 카테고리 범위용 — 데이터가 쌓이면 켠다(libs/shared/categories.ts CATEGORY_SCOPE_SURFACES).
  categoryId      Int?
  sellerPhone     String?
  sellerEmail     String?
  sellerBlogUrl   String?
  sellerCafeNick  String?
  sellerBandNick  String?
  sellerProofImage String?
  sellerTrustNote String?
  bloodlineRootId Int?
  startPrice      Int       // 시작가
  currentPrice    Int       // 현재 최고 입찰가
  minBidIncrement Int       @default(1000) // 최소 입찰 단위 (원)
  endAt           DateTime  // 경매 종료 시간
  status          String    @default("진행중") // 진행중, 종료, 유찰, 취소

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  bids            Bid[]
  reports         AuctionReport[]
  winnerId        Int?      // 낙찰자 ID
  /// 운영자 숨김. 작성자·관리자에게만 보인다. 숨길 때 진행중이면 취소한다.
  isHidden        Boolean   @default(false)
  /// { sireMm?, damMm?, generation? } — libs/shared/pedigree-note.ts. bloodlineRootId 가 없으면 null.
  pedigreeNote    Json?
  /// 회차(1부터). 분양자가 유찰·미입양 경매를 다시 시작할 때마다 +1(libs/shared/auctionRestart.ts).
  round           Int       @default(1)
  /// 경매 목록 정렬 시각. 등록·다시 시작 때 now. 이 열을 만들기 전 경매는 모두 마이그레이션 시각이라 목록은 id 로 한 번 더 정렬한다.
  listedAt        DateTime  @default(now())
  /// 상세 조회 수(분양자 본인 제외, POST /api/auctions/:id/view). 목록 '지금 많이 보는 중' 딱지 기준(libs/shared/auctionBadge.ts).
  viewCount       Int       @default(0)
  restarts        AuctionRestart[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endAt])
  @@index([category])
  @@index([categoryId])
  @@index([bloodlineRootId, endAt])
  @@index([listedAt])
}

model Bid {
  id         Int      @id @default(autoincrement())
  amount     Int      // 입찰 금액
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId  Int
  createdAt  DateTime @default(now())
  /// 경매를 다시 시작해 지난 회차가 된 입찰. 현재 회차 입찰·최고가·낙찰은 이 값이 null 인 것만 본다.
  archivedAt DateTime?

  @@index([auctionId])
  @@index([userId])
}

/// 경매 다시 시작 기록(앱 docs/prd/auction-restart.md). 지난 회차 요약과 입찰 막은 이전 낙찰자(previousWinnerId)의 출처.
model AuctionRestart {
  id               Int      @id @default(autoincrement())
  auctionId        Int
  /// 마감된 회차 번호(처음 다시 시작하면 1)
  round            Int
  /// 마감 상태: 유찰 | 종료
  previousStatus   String
  previousEndAt    DateTime
  /// 마감 때 현재가(낙찰가 또는 시작가)
  previousPrice    Int
  previousBidCount Int
  /// 낙찰 후 입양하지 않아 다시 시작했으면 그 낙찰자. 이 경매에 다시 입찰할 수 없다(Auction.winnerId 처럼 FK 없음).
  previousWinnerId Int?
  /// AuctionRestartReasonId(NO_CONTACT|DECLINED|OTHER). 유찰이면 null
  reason           String?
  /// 자동 접수한 '낙찰 후 노쇼' AuctionReport.id
  reportId         Int?
  restartedBy      Int
  newEndAt         DateTime
  createdAt        DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([previousWinnerId])
}

enum AuctionReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum AuctionReportAction {
  NONE
  STOP_AUCTION
  BAN_USER
  STOP_AUCTION_AND_BAN
}

model AuctionReport {
  id               Int                 @id @default(autoincrement())
  auctionId        Int
  reporterId       Int
  reportedUserId   Int
  reason           String
  detail           String
  status           AuctionReportStatus @default(OPEN)
  resolutionAction AuctionReportAction @default(NONE)
  resolutionNote   String?
  resolvedBy       Int?
  resolvedAt       DateTime?
  /// 처리하면서 준 사용자 제재(UserSanction.id)
  sanctionId       Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  auction      Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reporter     User    @relation("AuctionReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User    @relation("AuctionReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolver     User?   @relation("AuctionReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([auctionId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// 운영자 조치 기록(숨김·숨김 해제·삭제)
// ============================================================

enum ModerationTargetType {
  POST
  COMMENT
  PRODUCT
  AUCTION
  BLOODLINE_CARD
}

enum ModerationActionType {
  HIDE
  UNHIDE
  DELETE
}

model ModerationLog {
  id           Int                  @id @default(autoincrement())
  actorId      Int
  targetType   ModerationTargetType
  targetId     Int
  /// 콘텐츠 작성자. 삭제 뒤에도 추적한다.
  targetUserId Int?
  action       ModerationActionType
  /// 운영자 메모(자유 입력)
  reason       String?
  /// 제재 사유 코드(libs/shared/sanction.ts SANCTION_REASONS). 작성자 알림에 사유 문구로 쓴다
  reasonCode   String?
  /// 신고 처리에서 온 조치면 Report.id
  reportId     Int?
  /// 삭제 시 원문 보존용 { title, excerpt }
  snapshot     Json?
  createdAt    DateTime             @default(now())

  actor User @relation("ModerationLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

// ============================================================
// 사용자 제재(경고·기간 정지·영구 정지·해제) — 앱 docs/prd/admin-moderation.md
// ============================================================

enum SanctionType {
  WARNING    // 경고. 계정 상태는 그대로
  SUSPENSION // 기간 정지. 정지 중이면 남은 기간에 더한다
  BAN        // 영구 정지
  LIFT       // 정지·영구 정지 해제
}

/// 사용자 제재 이력. User.status 변경과 같은 트랜잭션에서 남긴다.
/// 대상자용 응답에는 internalNote·actorId·신고자 정보를 넣지 않는다.
model UserSanction {
  id              Int                   @id @default(autoincrement())
  userId          Int
  actorId         Int
  type            SanctionType
  /// libs/shared/sanction.ts SANCTION_REASONS 키
  reasonCode      String
  /// 대상자에게 보이는 운영자 메시지(최대 300자)
  messageToUser   String?
  /// 운영자만 보는 메모(최대 500자)
  internalNote    String?
  /// SUSPENSION 일수(1·3·7·10·30)
  days            Int?
  startsAt        DateTime              @default(now())
  /// SUSPENSION 적용 뒤 정지 만료 시각(남은 기간에 더한 결과)
  endsAt          DateTime?
  /// 신고 처리에서 온 제재면 Report.id / AuctionReport.id
  reportId        Int?
  auctionReportId Int?
  /// 관련 콘텐츠
  targetType      ModerationTargetType?
  targetId        Int?
  /// 관련 콘텐츠 { title, excerpt }. 콘텐츠가 지워져도 대상자에게 보여 준다
  snapshot        Json?
  /// 대상자가 확인 모달에서 확인한 시각. WARNING·SUSPENSION 만 쓴다
  acknowledgedAt  DateTime?
  createdAt       DateTime              @default(now())

  user  User @relation("UserSanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("UserSanctionActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, acknowledgedAt])
  @@index([actorId, createdAt])
}

// ============================================================
// 통합 신고 · 사용자 차단
// ============================================================

enum ReportTargetType {
  POST
  COMMENT
  PRODUCT
  CHAT_ROOM
  USER
  BLOODLINE_CARD
  TOWN_MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ReportAction {
  NONE
  REMOVE_CONTENT
  BAN_USER
  REMOVE_CONTENT_AND_BAN
}

/// 게시글·댓글·상품·채팅방·사용자 통합 신고. 경매 신고는 AuctionReport 를 그대로 쓴다.
model Report {
  id               Int              @id @default(autoincrement())
  targetType       ReportTargetType
  /// 대상 id. CHAT_ROOM 이면 채팅방 id, USER 면 사용자 id.
  targetId         Int
  reporterId       Int
  reportedUserId   Int
  reason           String
  detail           String?
  status           ReportStatus     @default(OPEN)
  /// 옛 처리 방식의 조치. 새 처리는 contentAction·sanctionId 를 함께 쓰고 여기엔 가장 가까운 값을 남긴다.
  resolutionAction ReportAction     @default(NONE)
  /// 처리하면서 한 콘텐츠 조치(HIDE·DELETE). 조치 없으면 null
  contentAction    ModerationActionType?
  /// 처리하면서 준 사용자 제재(UserSanction.id)
  sanctionId       Int?
  resolutionNote   String?
  resolvedBy       Int?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reporter     User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolver     User? @relation("ReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status, createdAt])
}

/// blocker 가 blocked 를 차단. 콘텐츠 숨김은 단방향, 채팅은 양방향 금지.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ============================================================
// 기네스북 (곤충 기록 시스템)
// ============================================================

model InsectRecord {
  id          Int      @id @default(autoincrement())
  species     String   // 종명 (장수풍뎅이, 사슴벌레 등)
  recordType  String   // "size" (크기 mm) 또는 "weight" (무게 g)
  value       Float    // 실제 측정값
  photo       String   // 증거 사진 (Cloudflare Image ID)
  description String?  // 추가 설명

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  isVerified  Boolean  @default(false) // 관리자 검증 여부

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([species, recordType])
  @@index([userId])
  @@index([species, recordType, value])
}

model GuinnessSpecies {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  aliases    String[]
  isActive   Boolean  @default(true)
  isOfficial Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  submissions GuinnessSubmission[]
}

model GuinnessSubmission {
  id               Int      @id @default(autoincrement())
  userId           Int
  userName         String
  species          String
  speciesId        Int?
  speciesRawText   String?
  recordType       GuinnessRecordType
  value            Float
  measurementDate  DateTime?
  description      String?
  proofPhotos      String[]
  contactPhone     String?
  contactEmail     String?
  consentToContact Boolean
  submittedAt      DateTime @default(now())
  slaDueAt         DateTime
  resubmitCount    Int      @default(0)
  status           GuinnessSubmissionStatus @default(pending)
  reviewReasonCode GuinnessRejectionReasonCode?
  reviewMemo       String?
  reviewedBy       Int?
  reviewedAt       DateTime?
  approvedRecordId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesRef  GuinnessSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([species, recordType])
  @@index([status])
}

model AdminBanner {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  href        String
  bgClass     String
  order       Int
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model BloodlineCard {
  id                   Int                      @id @default(autoincrement())
  cardType             BloodlineCardType        @default(BLOODLINE)
  speciesType          String?
  /// Category.id(speciesType 이름에서 푼 값). 관심 카테고리 범위용 — 데이터가 쌓이면 켠다(CATEGORY_SCOPE_SURFACES).
  categoryId           Int?
  bloodlineReferenceId Int?
  parentCardId         Int?
  status               BloodlineCardStatus      @default(ACTIVE)
  transferPolicy       BloodlineCardTransferPolicy @default(NONE)
  issueCount           Int                      @default(0)
  transferCount        Int                      @default(0)
  visualStyle          String                   @default("noir")
  creatorId            Int
  currentOwnerId       Int
  name                 String
  description          String?
  image                String?
  /// 산지. libs/shared/regions.ts REGIONS 의 sido / sigungu 값. sigungu 는 sido 가 있을 때만.
  originSido           String?
  originSigungu        String?
  /// 출처 카드(LINE) 보유자가 켜면 혈통 페이지·프로필에 닉네임이 보인다. 카드가 다음 사람에게 옮겨가면 false 로 돌아간다.
  ownerNameVisible     Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  creator                  User                  @relation("BloodlineCardCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  currentOwner             User                  @relation("BloodlineCardOwner", fields: [currentOwnerId], references: [id], onDelete: Cascade)
  events                   BloodlineCardEvent[]
  transfers                BloodlineCardTransfer[]
  owners                   BloodlineCardOwner[]

  @@index([cardType, currentOwnerId, createdAt])
  @@index([cardType, creatorId, createdAt])
  @@index([bloodlineReferenceId])
  @@index([parentCardId])
  @@index([currentOwnerId, createdAt])
  @@index([creatorId])
  @@index([categoryId])
}

model BloodlineCardEvent {
  id           Int      @id @default(autoincrement())
  cardId       Int
  action       BloodlineCardEventType
  actorUserId  Int?
  fromUserId   Int?
  toUserId     Int?
  note         String?
  createdAt    DateTime @default(now())

  card         BloodlineCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser    User?         @relation("BloodlineCardEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromUser     User?         @relation("BloodlineCardEventFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser       User?         @relation("BloodlineCardEventTo", fields: [toUserId], references: [id], onDelete: SetNull)
  relatedCardId Int?

  @@index([cardId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

model BloodlineCardTransfer {
  id         Int      @id @default(autoincrement())
  cardId     Int
  fromUserId Int?
  toUserId   Int
  note       String?
  createdAt  DateTime @default(now())

  card     BloodlineCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromUser User?         @relation("BloodlineCardTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User          @relation("BloodlineCardTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([toUserId, createdAt])
}

/// 보유자 테이블. 예전 런타임 DDL 로 만들던 것을 편입한다(20261009000100_bloodline_v2_schema).
/// currentOwnerId 의 거울일 뿐 권한 판정에는 쓰지 않는다(libs/server/bloodline-ownership.ts). P2 에서 삭제 후보.
model BloodlineCardOwner {
  bloodlineCardId Int
  userId          Int
  grantedAt       DateTime @default(now())

  card BloodlineCard @relation(fields: [bloodlineCardId], references: [id], onDelete: Cascade)
  user User          @relation("BloodlineCardOwnerRows", fields: [userId], references: [id], onDelete: Cascade)

  @@id([bloodlineCardId, userId])
  @@index([userId, bloodlineCardId])
}

enum BloodlineCardType {
  BLOODLINE
  LINE
}

enum BloodlineCardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum BloodlineCardTransferPolicy {
  NONE
  ONE_TIME
  LIMITED_CHAIN
  LIMITED_COUNT
  VERIFIED_ONLY
}

enum BloodlineCardEventType {
  BLOODLINE_CREATED
  BLOODLINE_TRANSFER
  LINE_CREATED
  LINE_ISSUED
  LINE_TRANSFER
  CARD_REVOKED
}

enum VoiceInquiryType {
  BUG_REPORT
  FEATURE_REQUEST
  DEV_TEAM_REQUEST
}

enum VoiceInquiryStatus {
  OPEN
  IN_REVIEW
  DONE
  REJECTED
}

model VoiceInquiry {
  id           Int                @id @default(autoincrement())
  type         VoiceInquiryType
  status       VoiceInquiryStatus @default(OPEN)
  title        String
  description  String
  contactEmail String
  requesterId  Int?
  requesterName String?
  adminNote    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model LandingPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

/// 탈퇴자 개인정보 분리 보관. 30일 뒤 원문은 파기하고 행(userId, snsIdHash)만 남긴다.
model UserDeletionRecord {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  provider    String
  /// 보관 기간 중 원문. 파기 시 null
  snsId       String?
  /// HMAC-SHA256(snsId). 파기 후에도 탈퇴 이력 확인용으로 유지
  snsIdHash   String
  email       String?
  phone       String?
  /// 탈퇴 전 닉네임 (CS 식별용)
  name        String?
  reason      String?
  requestedAt DateTime  @default(now())
  purgeAt     DateTime
  purgedAt    DateTime?

  @@index([snsId])
  @@index([snsIdHash])
  @@index([purgeAt, purgedAt])
}

/// 동네 홈 방문 기록(하루 1행). '이번 주 {시} 근처에서 N명이 둘러봤어요' 집계용(앱 docs/prd/community-vibe.md §3.1·§4).
/// 방문 당시 사용자의 시/도·시/군/구 이름만 남긴다(좌표 미저장). day 는 KST 날짜.
model RegionVisit {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  regionSido    String
  regionSigungu String
  day           DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([userId, day])
  @@index([day, regionSido, regionSigungu])
}

/// 탈퇴 시 Apple 로그인 연결을 끊기 위한 refresh token(App Store 심사 5.1.1(v), libs/server/appleTokens.ts).
/// Apple sub(User.snsId) 기준이라 계정을 만들기 전(웹 로그인 콜백)에도 저장한다. 토큰은 AES-GCM 으로 암호화한다.
model AppleSignInToken {
  snsId        String   @id
  /// code 를 만든 클라이언트 ID(iOS 번들 ID 또는 Services ID). 철회도 같은 ID 로 해야 한다.
  clientId     String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 동네 브리더 '손 흔들어 인사하기'(2026-10-12). 보낸 사람·받는 사람 한 쌍에 1행(같은 사람에겐 한 번),
/// 보낸 사람은 KST 하루 10명까지(libs/shared/chatWave.ts WAVE_DAILY_LIMIT). 인사 문구는 채팅 메시지로 같이 남는다.
model ChatWave {
  id          Int      @id @default(autoincrement())
  sender      User     @relation("WaveSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Int
  recipient   User     @relation("WaveReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  chatRoomId  Int
  presetId    String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId])
  @@index([senderId, day])
  @@index([recipientId])
}

/// 찬반 토론의 쪽. A = 첫 선택지(화면 주황), B = 둘째 선택지(화면 검정).
enum DebateSide {
  A
  B
}

/// 찬반 토론 글(Post.category === "토론")의 선택지·기간. 글 1개당 1행.
/// 집계(참여 수·%)는 저장하지 않고 DebateVote 에서 센다(탈퇴 cascade 로 어긋나지 않게). 앱 docs/prd/live-talk.md
model Debate {
  post             Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId           Int          @id
  optionA          String       @db.VarChar(12)
  optionB          String       @db.VarChar(12)
  /// null = 상시 토론(운영자만 연다, 마감 없음). 회원 토론은 API 가 늘 채운다. 앱 docs/prd/evergreen-debate.md
  endsAt           DateTime?
  /// 상시 토론 분야 키(libs/shared/debateFormat EVERGREEN_FIELDS). 회원 토론은 null.
  evergreenField   String?      @db.VarChar(20)
  /// 같은 분야 안 순서(작을수록 위).
  evergreenOrder   Int?
  /// 작성자 말고 처음 투표한 시각. 이 뒤엔 질문·선택지를 못 고친다.
  firstOtherVoteAt DateTime?
  /// 앱 안 결과 알림을 만든 시각(한 번만).
  resultNotifiedAt DateTime?
  createdAt        DateTime     @default(now())
  votes            DebateVote[]

  @@index([endsAt])
  @@index([evergreenField, evergreenOrder])
}

/// 토론 투표. 한 사람 한 표, 끝나기 전엔 쪽을 바꿀 수 있다(switchedAt = 마지막으로 바꾼 시각).
model DebateVote {
  id         Int        @id @default(autoincrement())
  debate     Debate     @relation(fields: [postId], references: [postId], onDelete: Cascade)
  postId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  side       DebateSide
  switchedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([postId, userId])
  @@index([postId, updatedAt])
  @@index([userId])
}

enum TownMessageType {
  TEXT
  IMAGE
  PRODUCT
}

/// 동네 사랑방 메시지. 방이 아니라 보낸 사람의 시/군/구를 저장하고, 읽을 때 읽는 사람의 반경 50km 범위로 거른다.
/// 최근 7일만 보이고 지우지는 않는다. 앱 docs/prd/live-talk.md §3.4
model TownMessage {
  id            Int             @id @default(autoincrement())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  regionSido    String
  regionSigungu String
  type          TownMessageType @default(TEXT)
  body          String?         @db.VarChar(300)
  image         String?
  productId     Int?
  replyToId     Int?
  /// 운영자 숨김 또는 신고 3건 자동 가림.
  isHidden      Boolean         @default(false)
  /// 보낸 사람이 지운 시각('삭제한 메시지예요'로 남긴다).
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([regionSido, regionSigungu, id])
  @@index([userId, createdAt])
  @@index([createdAt])
}
