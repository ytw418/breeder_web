{
  "name": "bredy_web",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && npm run typecheck && next build",
    "vercel-build": "node scripts/check-migration-safety.mjs && prisma migrate deploy && prisma generate && next build",
    "db:check-migrations": "node scripts/check-migration-safety.mjs && scripts/check-migrations-local.sh",
    "db:backup": "scripts/db-backup.sh",
    "db:restore-check": "scripts/db-restore-check.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:ci": "npm run lint && npm run typecheck && npm run check:i18n && npm test -- --ci --runInBand",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify:full": "npm run verify:ci && npm run build",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth:setup": "PLAYWRIGHT_AUTH_SETUP=1 PLAYWRIGHT_AUTH_FILE=playwright/.auth/user.json playwright test e2e/auth.setup.spec.ts --headed --project=chromium",
    "test:e2e:auth": "PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json playwright test -g @auth",
    "test:e2e:auth:headed": "PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json playwright test -g @auth --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:help": "node scripts/e2e-help.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:dummy": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-dummy.ts",
    "seed:dummy:reset": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-dummy.ts --reset",
    "seed:auction-flow": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-auction-flow.ts",
    "seed:community": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-community.ts",
    "issue:auto-pr": "node scripts/issue-auto-pr.mjs",
    "import:morphmarket:auction": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register scripts/import-morphmarket-auctions.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/nextjs": "^10.38.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "20.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^1.6.1",
    "autoprefixer": "10.4.14",
    "axios": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "encoding": "^0.1.13",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.2.1",
    "firebase": "^9.15.0",
    "firebase-admin": "^13.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.439.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postcss": "8.4.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.3",
    "swr": "^2.2.0",
    "tailwind-merge": "^3.2.0",
    "tailwind-scrollbar-hide": "^1.1.7",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@faker-js/faker": "^9.7.0",
    "@jest/globals": "^30.0.0-beta.3",
    "@playwright/test": "^1.51.1",
    "@svgr/webpack": "^6.5.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^9.0.2",
    "encoding": "^0.1.13",
    "identity-obj-proxy": "^3.0.0",
    "intl-messageformat": "^11.2.15",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jest-junit": "^16.0.0",
    "prisma": "^6.6.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "yahoo": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/yahoo.ts"
  }
}
